+/// 웹 빌드용. web/index.html 의 `again1907RegistrationComplete()` 가
+/// Google Ads 전환을 보내고, again1907.kr 안의 iframe 이면 부모 창에 postMessage 한다.
+/// 스탭 링크(?staff=1)·운영자 웹(/admin/)에서는 그 함수가 없으니 아무것도 하지 않는다.
+library;
+
+import 'dart:js_interop';
+
+@JS('again1907RegistrationComplete')
+external JSFunction? get _registrationCompleteHook;
+
+void reportRegistrationComplete() {
+  try {
+    _registrationCompleteHook?.callAsFunction();
+  } catch (_) {
+    // 광고 태그가 막혀 있어도(광고 차단기 등) 신청 완료 화면은 그대로 보여야 한다.
+  }
+}
