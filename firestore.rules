rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 설정은 모든 사용자가 읽기만 가능
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 신청/방/관리자 데이터는 클라이언트에서 직접 접근 금지
    match /participants/{id} {
      allow read, write: if false;
    }
    match /rooms/{id} {
      allow read, write: if false;
    }
    match /admins/{id} {
      allow read, write: if false;
    }
  }
}
